---
import '../styles/global.css';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { business, treatments } from '../data/site';
import { href } from '../data/helpers';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  /** Topic pre-filled into "Text us" messages on this page. */
  topic?: string;
}

const { title, description, schema = [], topic } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/og.png'), Astro.site);

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const clinic = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': new URL(href('/#clinic'), Astro.site).href,
  name: business.name,
  url: new URL(href('/'), Astro.site).href,
  telephone: business.tel,
  email: business.email,
  image: ogImage.href,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.street,
    addressLocality: 'Boston',
    addressRegion: business.region,
    postalCode: business.zip,
    addressCountry: 'US',
  },
  areaServed: ['Roslindale', 'West Roxbury', 'Jamaica Plain', 'Hyde Park', 'Dedham', 'Boston'],
  sameAs: [business.instagram],
  openingHoursSpecification: business.hours.flatMap((h, i) =>
    h ? [{ '@type': 'OpeningHoursSpecification', dayOfWeek: dayNames[i], opens: h.open, closes: h.close }] : [],
  ),
  availableService: treatments.map((t) => ({
    '@type': 'MedicalProcedure',
    name: t.name,
    url: new URL(href(`/${t.slug}/`), Astro.site).href,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e0d0b" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`
@font-face{font-family:'Instrument Serif';font-style:normal;font-weight:400;font-display:swap;src:url(${serifUrl}) format('woff2')}
@font-face{font-family:'Instrument Serif';font-style:italic;font-weight:400;font-display:swap;src:url(${serifItalicUrl}) format('woff2')}
@font-face{font-family:'Geist';font-style:normal;font-weight:100 900;font-display:swap;src:url(${sansUrl}) format('woff2-variations')}
@font-face{font-family:'Geist Mono';font-style:normal;font-weight:100 900;font-display:swap;src:url(${monoUrl}) format('woff2-variations')}
@font-face{font-family:'Instrument Serif Fallback';src:local('Times New Roman'),local('Georgia');size-adjust:86%;ascent-override:96%;descent-override:26%}
@font-face{font-family:'Geist Fallback';src:local('Arial'),local('Helvetica Neue');size-adjust:103%;ascent-override:92%;descent-override:22%}
`}
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Failsafe: if the main script never runs, drop the hidden reveal states.
      setTimeout(function () {
        if (!window.__rv) document.documentElement.classList.remove('js');
      }, 3000);
      if (/[?&]review\b/.test(location.search)) document.documentElement.classList.add('review-mode');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([clinic, ...schema])} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar topic={topic} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
