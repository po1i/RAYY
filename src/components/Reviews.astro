---
import Icon from './Icon.astro';
import { business, reviews } from '../data/site';
const [lead, ...others] = reviews;
---

<section class="section rev" aria-labelledby="rev-title">
  <div class="wrap">
    <div class="rev__head">
      <h2 id="rev-title" class="eyebrow">What clients say</h2>
      <p class="rev__score">
        <span class="rev__num">{business.rating}</span>
        <span class="rev__meta">
          <span class="stars" aria-hidden="true">
            <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
          </span>
          <span class="mono">{business.reviewCount} reviews</span>
        </span>
      </p>
    </div>

    <figure class="rev__lead" data-reveal data-placeholder={lead.placeholder || undefined}>
      <blockquote>
        <p>“{lead.quote}”</p>
      </blockquote>
      <figcaption class="mono">— {lead.who}</figcaption>
    </figure>

    <div class="rev__more">
      {
        others.map((r, i) => (
          <figure data-reveal style={`--i:${i + 1}`} data-placeholder={r.placeholder || undefined}>
            <blockquote>
              <p>“{r.quote}”</p>
            </blockquote>
            <figcaption class="mono">— {r.who}</figcaption>
          </figure>
        ))
      }
      <a class="link rev__all" href={business.reviewsUrl} target="_blank" rel="noopener">
        Read every review on Google <span class="sr-only">(opens in a new tab)</span>
        <Icon name="arrow" class="ic" />
      </a>
    </div>
  </div>
</section>

<style>
  .rev__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-5);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--line);
  }

  .rev__score {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .rev__num {
    font-family: var(--serif);
    font-size: var(--t-2xl);
    line-height: 0.9;
  }

  .rev__meta {
    display: grid;
    gap: var(--s-1);
    font-size: var(--t-xs);
    color: var(--bone-2);
  }

  .stars {
    display: inline-flex;
    gap: 1px;
    color: var(--brass);
  }

  .stars :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .rev__lead {
    padding-block: var(--s-8);
  }

  .rev__lead p {
    font-family: var(--serif);
    font-size: var(--t-2xl);
    line-height: 1.08;
    letter-spacing: -0.01em;
    max-width: 22ch;
    text-indent: -0.4em;
  }

  figcaption {
    margin-top: var(--s-5);
    font-size: var(--t-xs);
    color: var(--taupe);
  }

  .rev__more {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-6);
    align-items: end;
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .rev__more figure:nth-child(1) {
    grid-column: 1 / span 4;
  }

  .rev__more figure:nth-child(2) {
    grid-column: 6 / span 4;
  }

  .rev__more p {
    font-size: var(--t-lg);
    line-height: 1.45;
    color: var(--bone-2);
  }

  .rev__all {
    grid-column: 11 / -1;
    justify-self: end;
    font-size: var(--t-sm);
    white-space: nowrap;
  }

  @media (max-width: 59.99rem) {
    .rev__more {
      grid-template-columns: 1fr;
    }

    .rev__more figure:nth-child(n),
    .rev__all {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
