---
/**
 * Image slot. Renders the real photo when `src` is given; until the clinic
 * supplies photography it paints a lit, sculptural placeholder in CSS so the
 * layout, crop and motion can be judged without stock imagery.
 */
interface Props {
  src?: string;
  alt?: string;
  variant?: 'warm' | 'cool' | 'deep';
  ratio?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, alt = '', variant = 'warm', ratio = '4 / 5', class: className, eager = false, sizes = '50vw' } = Astro.props;
---

<div class:list={['art', `art--${variant}`, className]} style={`--ratio:${ratio}`} data-placeholder={!src || undefined}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
    ) : (
      <div class="art__paint" aria-hidden="true">
        <span class="art__form" />
      </div>
    )
  }
  <span class="art__light" aria-hidden="true"></span>
  <slot />
</div>

<style>
  .art {
    --wall-a: #ddd4c7;
    --wall-b: #c9bfb1;
    --tone-a: #f4e6d6;
    --tone-b: #dcbfa4;
    --tone-c: #b48d70;
    --tone-d: #7d5c46;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--wall-b);
    isolation: isolate;
  }

  .art--cool {
    --wall-a: #d6d2ca;
    --wall-b: #bdb8ae;
    --tone-a: #f1eee8;
    --tone-b: #d5d0c6;
    --tone-c: #a8a196;
    --tone-d: #6f6a61;
  }

  .art--deep {
    --wall-a: #d3c6b5;
    --wall-b: #b8a891;
    --tone-a: #e2c3a3;
    --tone-b: #b98d68;
    --tone-c: #855d42;
    --tone-d: #4f3526;
  }

  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Plaster wall lit from the upper left. */
  .art__paint {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 70% at 18% 8%, var(--wall-a) 0%, transparent 70%),
      linear-gradient(160deg, var(--wall-a), var(--wall-b));
  }

  /* Cropped hard so only the curve shows: a macro of a lit surface, like a
     shoulder or cheekbone, rather than an object sitting in the frame. */
  .art__form {
    position: absolute;
    left: 16%;
    top: 22%;
    width: 150%;
    aspect-ratio: 0.82;
    border-radius: 50%;
    transform: rotate(-22deg);
    background: radial-gradient(
      circle at 20% 20%,
      var(--tone-a) 0%,
      var(--tone-b) 20%,
      var(--tone-c) 44%,
      var(--tone-d) 70%
    );
    box-shadow:
      -40px -10px 90px rgb(72 54 40 / 0.28),
      inset 14px 10px 30px rgb(255 248 238 / 0.35);
  }

  /* Raking light; parents translate it to "reveal" the surface. */
  .art__light {
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(
      100deg,
      transparent 38%,
      rgb(255 250 242 / 0.14) 46%,
      rgb(255 250 242 / 0.3) 50%,
      rgb(255 250 242 / 0.14) 54%,
      transparent 62%
    );
    transform: translate3d(-35%, 0, 0);
    pointer-events: none;
  }
</style>
