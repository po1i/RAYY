---
interface Props {
  name: 'phone' | 'message' | 'arrow' | 'arrow-down' | 'pin' | 'star' | 'plus' | 'check' | 'menu' | 'close' | 'drag';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'phone' && (
    <path d="M5.5 3.5h3l1.5 4-2 1.25a11 11 0 0 0 7.25 7.25l1.25-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />
  )}
  {name === 'message' && <path d="M4 5.5h16v10H9l-5 4v-14Z" />}
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === 'arrow-down' && <path d="M12 5v14m-5-5 5 5 5-5" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.25" />
    </>
  )}
  {name === 'star' && (
    <path
      fill="currentColor"
      stroke="none"
      d="m12 3.5 2.6 5.5 6 .7-4.45 4.1 1.2 5.95L12 16.8l-5.35 2.95 1.2-5.95L3.4 9.7l6-.7L12 3.5Z"
    />
  )}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'menu' && <path d="M4 9h16M4 15h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'drag' && <path d="m9 7-5 5 5 5M15 7l5 5-5 5" />}
</svg>
