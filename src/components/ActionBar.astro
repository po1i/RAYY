---
import Icon from './Icon.astro';
import { business } from '../data/site';
import { href, telHref, smsHref, consultText } from '../data/helpers';

interface Props {
  topic?: string;
}
const { topic } = Astro.props;
const book = Astro.url.pathname === href('/') ? '#book' : href('/#book');
---

<nav class="bar" aria-label="Quick contact" data-bar>
  <a class="bar__btn bar__btn--primary" href={telHref}>
    <Icon name="phone" />
    <span>Call</span>
  </a>
  {
    business.smsEnabled && (
      <a class="bar__btn" href={smsHref(consultText(topic))} data-sms data-sms-base={topic ?? ''}>
        <Icon name="message" />
        <span>Text</span>
      </a>
    )
  }
  <a class="bar__btn" href={book}>
    <Icon name="arrow-down" />
    <span>Call me back</span>
  </a>
</nav>

<style>
  .bar {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 60;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: var(--s-2);
      padding: var(--s-2) var(--s-3) max(var(--s-2), env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(1.2);
      backdrop-filter: blur(16px) saturate(1.2);
      box-shadow: 0 -1px 0 var(--line);
    }
  }

  .bar__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 3.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform var(--dur-1) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .bar__btn:active {
    transform: scale(0.96);
  }

  .bar__btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .bar__btn--primary {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: none;
  }
</style>
